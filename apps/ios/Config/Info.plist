<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.ericcora.monopolydeal.join</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>monopolydeal</string>
			</array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Monopoly Deal finds phones close by so you can play at one table without the internet.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_mdeal-nearby._tcp</string>
		<string>_mdeal-nearby._udp</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Monopoly Deal uses Bluetooth to connect to phones close by when there's no Wi-Fi.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
