{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_MULTIPLAYER_API_URL=https://monopolydeal-multiplayer.onrender.com npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/join/:roomCode",
      "destination": "/index.html"
    },
    {
      "source": "/api/multiplayer/:path*",
      "destination": "https://monopolydeal-multiplayer.onrender.com/api/multiplayer/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://monopolydeal-multiplayer.onrender.com/socket.io/:path*"
    },
    {
      "source": "/api/turn/:path*",
      "destination": "/api/turn-rooms?path=:path*"
    }
  ],
  "functions": {
    "api/turn-rooms.js": {
      "maxDuration": 15
    }
  }
}
