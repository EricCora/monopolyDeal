# Optional for local development on localhost.
# Required when your frontend and multiplayer API are on different origins.
VITE_MULTIPLAYER_API_URL=https://your-multiplayer-api.example.com

# Reconnect-v1 feature flags (disabled by default)
VITE_MP_RECONNECT_V1=false
VITE_MP_RECONNECT_V1_UI=false
VITE_MP_VERSION_GUARD_V1=false
VITE_MP_RECONNECT_DEBUG=false
MP_RECONNECT_V1=false
MP_VERSION_GUARD_V1=false
MP_PAUSE_ON_DISCONNECT_V1=false
# Used only when MP_RECONNECT_V1=true
MP_RECONNECT_GRACE_MS=90000
