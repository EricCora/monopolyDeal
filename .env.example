# Optional for local development on localhost.
# Required when your frontend and multiplayer API are on different origins.
VITE_MULTIPLAYER_API_URL=https://your-multiplayer-api.example.com
VITE_MULTIPLAYER_SOCKET_ENABLED=true

# Reconnect diagnostics panel (dev optional)
VITE_MP_RECONNECT_DEBUG=false
# Reconnect/disconnect runtime configuration
MULTIPLAYER_SOCKET_ENABLED=true
MP_RECONNECT_GRACE_MS=90000
# Test servers only: lets the host choose the match seed.
MULTIPLAYER_ALLOW_CLIENT_SEED=false
